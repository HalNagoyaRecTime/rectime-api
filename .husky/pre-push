#!/usr/bin/env sh
set -eu

has_ref_update=0
has_non_delete_update=0
while read -r local_ref local_oid remote_ref remote_oid; do
  has_ref_update=1
  case "$local_ref:$local_oid" in
    "(delete):"*|*:0000000000000000000000000000000000000000)
      ;;
    *)
      has_non_delete_update=1
      ;;
  esac
done

if [ "$has_ref_update" -eq 1 ] && [ "$has_non_delete_update" -eq 0 ]; then
  echo "Skipping checks: remote branch deletion only."
  exit 0
fi

npm run type-check

if git rev-parse --verify origin/develop >/dev/null 2>&1; then
  npm exec -- vitest run --changed origin/develop
else
  echo "origin/develop not found; running full test suite."
  npm test
fi
