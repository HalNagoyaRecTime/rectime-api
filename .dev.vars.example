MICROSOFT_CLIENT_ID=YOUR_ENTRA_APP_CLIENT_ID
MICROSOFT_CLIENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_CONTENTS_HERE
-----END PRIVATE KEY-----"
MICROSOFT_CERT_THUMBPRINT=YOUR_CERT_THUMBPRINT_BASE64URL
MICROSOFT_TENANT=organizations
ALLOWED_MICROSOFT_TENANTS=YOUR_ENTRA_TENANT_ID
MICROSOFT_REDIRECT_URI=http://localhost:8787/api/v1/auth/microsoft/callback
MICROSOFT_MOBILE_REDIRECT_URI=com.rectime.mobile://auth/callback
FRONTEND_URL=http://localhost:5173
SESSION_EXPIRES_SEC=86400
JWT_SECRET=CHANGE_ME_TO_A_32_CHAR_OR_LONGER_RANDOM_SECRET
JWT_EXPIRES_SEC=3600
MOBILE_REFRESH_EXPIRES_SEC=7776000
