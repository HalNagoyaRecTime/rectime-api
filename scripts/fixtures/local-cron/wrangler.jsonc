{
  "name": "local-cron-test",
  "main": "worker.mjs",
  "compatibility_date": "2024-09-23",
  "triggers": { "crons": ["* * * * *", "0 18 * * *"] },
  "env": {
    "development": {
      "triggers": { "crons": [] },
      "kv_namespaces": [
        { "binding": "STATE", "id": "00000000000000000000000000000001" },
      ],
      "queues": {
        "producers": [{ "binding": "DELIVERY", "queue": "local-cron-test" }],
        "consumers": [
          {
            "queue": "local-cron-test",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
          },
        ],
      },
    },
  },
}
