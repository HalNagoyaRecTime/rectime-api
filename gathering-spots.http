@baseUrl = http://localhost:8787/api/v1
# POSTの応答で返る gathering_spot_id に更新してからPUTを実行する。
@gatheringSpotId = 3

### 1. 集合場所一覧を取得する（200）
GET {{baseUrl}}/gathering-spots
Accept: application/json

### 2. 集合場所を作成する（201）
POST {{baseUrl}}/gathering-spots
Content-Type: application/json
Accept: application/json

{
  "gatheringSpotName": "HTTPテスト用集合場所"
}

### 3. 作成した集合場所の名称を更新する（200）
PUT {{baseUrl}}/gathering-spots/{{gatheringSpotId}}
Content-Type: application/json
Accept: application/json

{
  "gatheringSpotName": "HTTPテスト用集合場所（更新後）"
}
