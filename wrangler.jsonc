{
  "name": "rectime-api",
  "account_id": "539494518db0c8b96ec2f6fdd30fb990",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
  },
  "vars": {
    "NODE_ENV": "production",
    "ALLOWED_ORIGINS": "https://recwatch.pages.dev,https://*.recwatch.pages.dev",
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_DELIVERY_QUEUE",
        "queue": "rectime-notification-delivery",
      },
    ],
    "consumers": [
      {
        "queue": "rectime-notification-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
        "retry_delay": 300,
        "max_concurrency": 10,
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "70197622340f44df8e24365695b5f1d0",
      "preview_id": "4c0dddfe16d94166841579765390f697",
    },
    {
      "binding": "MASTER_IMPORT_KV",
      "id": "REPLACE_WITH_REAL_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_REAL_PREVIEW_NAMESPACE_ID",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MASTER_IMPORT_COMMIT_LOCK",
        "class_name": "MasterImportCommitLock",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MasterImportCommitLock"],
    },
  ],
  "env": {
    "default": {
      "vars": {
        "NODE_ENV": "development",
        "PORT": "8787",
        "HOST": "0.0.0.0",
        "ALLOWED_ORIGINS": "http://localhost:5173",
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "local-auth-kv",
          "preview_id": "local-auth-kv",
        },
        {
          "binding": "MASTER_IMPORT_KV",
          "id": "local-master-import-kv",
          "preview_id": "local-master-import-kv",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rectime-api-dev",
          "database_id": "58250875-594b-401e-9e9f-66c19de7506f",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MASTER_IMPORT_COMMIT_LOCK",
            "class_name": "MasterImportCommitLock",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_DELIVERY_QUEUE",
            "queue": "rectime-notification-delivery-dev",
          },
        ],
        "consumers": [
          {
            "queue": "rectime-notification-delivery-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
            "retry_delay": 300,
            "max_concurrency": 10,
          },
        ],
      },
    },
    "development": {
      "vars": {
        "NODE_ENV": "development",
        "PORT": "8787",
        "HOST": "0.0.0.0",
        "ALLOWED_ORIGINS": "http://localhost:5173",
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "local-auth-kv",
          "preview_id": "local-auth-kv",
        },
        {
          "binding": "MASTER_IMPORT_KV",
          "id": "local-master-import-kv",
          "preview_id": "local-master-import-kv",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rectime-api-dev",
          "database_id": "58250875-594b-401e-9e9f-66c19de7506f",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MASTER_IMPORT_COMMIT_LOCK",
            "class_name": "MasterImportCommitLock",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_DELIVERY_QUEUE",
            "queue": "rectime-notification-delivery-dev",
          },
        ],
        "consumers": [
          {
            "queue": "rectime-notification-delivery-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
            "retry_delay": 300,
            "max_concurrency": 10,
          },
        ],
      },
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rectime-api",
      "database_id": "f031b887-a3a2-41f1-8c54-5ccdd323fcbb",
    },
  ],
}
