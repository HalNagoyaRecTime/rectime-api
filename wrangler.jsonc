{
  "name": "rectime-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-19",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "local-auth-kv",
      "preview_id": "local-auth-kv"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rec_time_stg",
      "database_id": "local-rec-time-stg"
    }
  ]
}
