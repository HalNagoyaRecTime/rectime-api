{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rectime-api",
  "account_id": "539494518db0c8b96ec2f6fdd30fb990",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://recwatch.pages.dev,https://*.recwatch.pages.dev",
  },
  // 本番Workerは workers.dev の既定URL(rectime-api.rectime-project.workers.dev)で
  // 公開されている(README.md参照)。カスタムドメイン/routesは未設定のため、
  // workers_dev/preview_urls はここでは変更しない(falseにすると本番アクセス不能になる)。
  "secrets": {
    "required": [
      "MICROSOFT_CLIENT_ID",
      "MICROSOFT_CLIENT_PRIVATE_KEY",
      "MICROSOFT_CERT_THUMBPRINT",
      "MICROSOFT_TENANT",
      "ALLOWED_MICROSOFT_TENANTS",
      "MICROSOFT_MOBILE_REDIRECT_URI",
      "FRONTEND_URL",
      "SESSION_EXPIRES_SEC",
      "JWT_SECRET",
      "JWT_EXPIRES_SEC",
      "MOBILE_REFRESH_EXPIRES_SEC",
      "FIREBASE_PROJECT_ID",
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY",
      "TEST_FCM_TOKEN",
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_DELIVERY_QUEUE",
        "queue": "rectime-notification-delivery",
      },
    ],
    "consumers": [
      {
        "queue": "rectime-notification-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
        "retry_delay": 300,
        "max_concurrency": 10,
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "70197622340f44df8e24365695b5f1d0",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rectime-api",
      "database_id": "f031b887-a3a2-41f1-8c54-5ccdd323fcbb",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MASTER_IMPORT_COMMIT_LOCK",
        "class_name": "MasterImportCommitLock",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MasterImportCommitLock"],
    },
  ],
  "env": {
    // `rectime-api-development` という別Workerとして作成される。
    // ローカル開発(wrangler dev --env development)と、mainブランチ以外へのpush先/
    // PRごとのpreviewデプロイ先(旧env.preview)の両方を兼ねる(env.previewは廃止し統合した)。
    // env.default は development と重複していたため削除した。
    //
    // web向けMicrosoft OAuthのredirect_uriは(#151により)リクエストURLから動的に
    // 組み立てられるため、wrangler側での設定は不要。ただしMicrosoft Entra側の
    // アプリ登録には、実際にデプロイされるWorkerのコールバックURL
    // (`wrangler versions upload --env development --preview-alias <固定名>` で得られる
    // `https://<固定名>-rectime-api-development.<subdomain>.workers.dev/api/v1/auth/microsoft/callback`)
    // を事前に追加登録しておく必要がある(preview-aliasを固定名で使い続けないとURLが変わり登録と食い違う)。
    "development": {
      "name": "rectime-api-development",
      "preview_urls": true,
      "vars": {
        "PORT": "8787",
        "HOST": "0.0.0.0",
        "ALLOWED_ORIGINS": "http://localhost:5173,https://recwatch.pages.dev,https://*.recwatch.pages.dev",
        // Entraアプリの「アプリケーション(クライアント)ID」。非公開の資格情報ではないためvarsで直接設定する。
        "MICROSOFT_CLIENT_ID": "be597fc9-7946-43a2-9ba8-6a96c96fd3b7",
        // Entraのマルチテナント共通エンドポイント値。環境によらず同一。
        "MICROSOFT_TENANT": "organizations",
        // 許可するEntraテナントID。
        "ALLOWED_MICROSOFT_TENANTS": "8d41d6d7-36ce-4e0c-8c6d-cf2c54c39039",
        // モバイルアプリのカスタムスキーム。バックエンドの環境によらず同一。
        "MICROSOFT_MOBILE_REDIRECT_URI": "com.rectime.mobile://auth/callback",
        // このdevelop backendに実際に接続するフロントエンド。
        // TODO: recwatchのPRごとのPreview URLに応じた動的化を別途検討する
        // (Refererヘッダーから取得しALLOWED_ORIGINSで検証する方式を予定)。
        // それまでは固定値。
        "FRONTEND_URL": "https://recwatch.pages.dev",
        "SESSION_EXPIRES_SEC": "86400",
        "JWT_EXPIRES_SEC": "3600",
        "MOBILE_REFRESH_EXPIRES_SEC": "7776000",
      },
      // triggersはトップレベルから継承されるため、明示しないと本番同様の毎分cronが
      // development(旧env.previewが明示的に無効化していた分)でも有効になってしまう。
      // stagingと同様、まずは無効で始める。
      "triggers": {
        "crons": [],
      },
      // secrets.required はここでは宣言しない: vitest-pool-workers
      // (test/apply-migrations.ts) がこの環境で62ファイル分のWorkerを並列起動する際、
      // 各起動ごとの追加検証コストでD1マイグレーションのbeforeAllフックが
      // 10秒タイムアウトし、テストスイートが不安定になることを確認したため。
      // ただし実デプロイ先としても使う以上、以下は実際には必須(`wrangler secret put <NAME> --env development`
      // で登録すること): MICROSOFT_CLIENT_PRIVATE_KEY / MICROSOFT_CERT_THUMBPRINT / JWT_SECRET /
      // FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY / TEST_FCM_TOKEN
      // (secrets.requiredを宣言しない代償として、デプロイ時の事前検証は効かない)。
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "7bdb66e8753148b09d88626e563193aa",
          // preview_id は `wrangler dev --remote` 専用。このリポジトリの
          // `npm run dev` はローカルシミュレーションのみで使わないが、
          // 既にdry-runで動作確認済みの値のため維持する。
          "preview_id": "7bdb66e8753148b09d88626e563193aa",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rectime-api-dev",
          "database_id": "58250875-594b-401e-9e9f-66c19de7506f",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MASTER_IMPORT_COMMIT_LOCK",
            "class_name": "MasterImportCommitLock",
          },
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_DELIVERY_QUEUE",
            "queue": "rectime-notification-delivery-dev",
          },
        ],
        "consumers": [
          {
            "queue": "rectime-notification-delivery-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
            "retry_delay": 300,
            "max_concurrency": 10,
          },
        ],
      },
    },
    // Cloudflare上のStaging環境。`rectime-api-staging` という別Workerとして作成される。
    // mainへのpushで自動デプロイされる(本番はworkflow_dispatchでの手動デプロイのみ)。
    // development/previewとは異なり、D1/KV/Queueは共有せず専用リソースを持つ
    // (本番相当の検証を行うための独立環境のため)。
    //
    // web向けMicrosoft OAuthのredirect_uriは(#151により)リクエストURLから動的に組み立てられるが、
    // Microsoft Entra側のアプリ登録(development/本番と共通の MICROSOFT_CLIENT_ID)には、
    // stagingのコールバックURL(`https://rectime-api-staging.<subdomain>.workers.dev/api/v1/auth/microsoft/callback`)
    // を別途追加登録しておく必要がある(未登録だとstagingでのMicrosoftログインのみ失敗する)。
    "staging": {
      "name": "rectime-api-staging",
      "vars": {
        "ALLOWED_ORIGINS": "https://recwatch.pages.dev,https://*.recwatch.pages.dev",
        // Entraアプリの「アプリケーション(クライアント)ID」。非公開の資格情報ではないためvarsで直接設定する。
        "MICROSOFT_CLIENT_ID": "be597fc9-7946-43a2-9ba8-6a96c96fd3b7",
        "MICROSOFT_TENANT": "organizations",
        "ALLOWED_MICROSOFT_TENANTS": "8d41d6d7-36ce-4e0c-8c6d-cf2c54c39039",
        "MICROSOFT_MOBILE_REDIRECT_URI": "com.rectime.mobile://auth/callback",
        "FRONTEND_URL": "https://recwatch.pages.dev",
        "SESSION_EXPIRES_SEC": "86400",
        "JWT_EXPIRES_SEC": "3600",
        "MOBILE_REFRESH_EXPIRES_SEC": "7776000",
      },
      "secrets": {
        "required": [
          "MICROSOFT_CLIENT_PRIVATE_KEY",
          "MICROSOFT_CERT_THUMBPRINT",
          "JWT_SECRET",
          "FIREBASE_PROJECT_ID",
          "FIREBASE_CLIENT_EMAIL",
          "FIREBASE_PRIVATE_KEY",
          "TEST_FCM_TOKEN",
        ],
      },
      // 本番相当のcronを検証したくなった時点で有効化を検討する。まずは無効で始める。
      "triggers": {
        "crons": [],
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "c91a0c7ab23943aa9c6135ad7ebfb583",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rectime-api-staging",
          "database_id": "f069ce58-7d88-4bd9-aab0-ab6c62eb2349",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MASTER_IMPORT_COMMIT_LOCK",
            "class_name": "MasterImportCommitLock",
          },
        ],
      },
      // staging専用のキュー。development/previewと共有しないため、producer/consumerとも
      // このWorkerだけで完結する(1キュー1consumerの制約に抵触しない)。
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_DELIVERY_QUEUE",
            "queue": "rectime-notification-delivery-staging",
          },
        ],
        "consumers": [
          {
            "queue": "rectime-notification-delivery-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
            "retry_delay": 300,
            "max_concurrency": 10,
          },
        ],
      },
    },
  },
}
