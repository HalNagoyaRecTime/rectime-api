{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rectime-api",
  "account_id": "496fe7ac33c4623ccc92b84920fa17bb",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "assets": {
    "directory": "./public",
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://recwatch-tokyo.pages.dev",
    "MICROSOFT_CLIENT_ID": "f6d39a67-2d3d-4947-a67f-fd5ce7e7661c",
    "FRONTEND_URL": "https://recwatch-tokyo.pages.dev",
    "SESSION_EXPIRES_SEC": "86400",
    "JWT_EXPIRES_SEC": "3600",
    "MOBILE_REFRESH_EXPIRES_SEC": "7776000",
    // DOCS_ENABLED は本番では意図的に設定しない。設定しない限り
    // /openapi.json と /docs は404になる(src/index.ts の requireDocsEnabled)。
    // API仕様・内部エラーコード・DB形状のヒントを無認証で公開しないため。
    "STUDENT_EMAIL_DOMAIN": "ths.hal.ac.jp",
    // /app/contact のリダイレクト先(Microsoft Forms「アプリお問い合わせ」)。
    // 空・未設定・https以外のときはリダイレクトせず404を返す。
    "CONTACT_FORM_URL": "https://forms.cloud.microsoft/r/LAsntFuQcF",
    // 2026年度レクリエーションの開催日（JST）。
    "EVENT_DATE": "2026-11-27",
    "IMAGES_BUCKET_URL": "https://539494518db0c8b96ec2f6fdd30fb990.r2.cloudflarestorage.com/rectime-images",
  },
  // 本番Workerは workers.dev の既定URL(rectime-api.rectime-project.workers.dev)で
  // 公開されている(README.md参照)。カスタムドメイン/routesは未設定のため、
  // workers_dev/preview_urls はここでは変更しない(falseにすると本番アクセス不能になる)。
  //
  // MICROSOFT_CLIENT_IDは非公開の資格情報ではないためvarsへ移行する余地はあるが、
  // `wrangler secret delete`は実行直後に新バージョンを即座にデプロイするため、本番の
  // 手動デプロイ化(workflow_dispatch)と組み合わせると「secretを消したがまだ誰も
  // dispatchしていない」空白時間がそのまま本番Microsoftログインの障害時間になる
  // (#204レビュー指摘)。安全な移行手順が確立するまでは、本番のみsecrets.requiredに
  // 残す(development/stagingはこのリスクがないためvars化済み)。
  "secrets": {
    "required": [
      "MICROSOFT_CLIENT_PRIVATE_KEY",
      "MICROSOFT_CERT_THUMBPRINT",
      "MICROSOFT_TENANT",
      "ALLOWED_MICROSOFT_TENANTS",
      "MICROSOFT_MOBILE_REDIRECT_URI",
      "JWT_SECRET",
      "FIREBASE_PROJECT_ID",
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
    ],
  },
  "triggers": {
    // "* * * * *": 通知配信(EVENT_DATE当日のみ実際に動く)。
    // "0 18 * * *" (UTC 18:00 = JST 3:00): アカウント削除の後片付け
    // 再実行(#345)。event.cronの値でindex.tsのscheduledハンドラが分岐する。
    "crons": ["* * * * *", "0 18 * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_DELIVERY_QUEUE",
        "queue": "rectime-notification-delivery",
      },
    ],
    "consumers": [
      {
        "queue": "rectime-notification-delivery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
        "retry_delay": 300,
        "max_concurrency": 10,
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "3acb0f285b304128ac9c69890c3cd387",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rectime-api",
      "database_id": "d4e4d78d-4b26-4b0f-9a10-851083b84e35",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "rectime-images",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MASTER_IMPORT_COMMIT_LOCK",
        "class_name": "MasterImportCommitLock",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MasterImportCommitLock"],
    },
  ],
  "env": {
    // Cloudflare上のStaging環境。`rectime-api-staging` という別Workerとして作成される。
    // developへのpushで、developmentと合わせて自動デプロイされる(本番はworkflow_dispatchでの手動デプロイのみ)。
    // development/previewとは異なり、D1/KV/Queueは共有せず専用リソースを持つ
    // (本番相当の検証を行うための独立環境のため)。
    //
    // web向けMicrosoft OAuthのredirect_uriは(#151により)リクエストURLから動的に組み立てられるが、
    // Microsoft Entra側のアプリ登録(development/本番と共通の MICROSOFT_CLIENT_ID)には、
    // stagingのコールバックURL(`https://rectime-api-staging.<subdomain>.workers.dev/api/v1/auth/microsoft/callback`)
    // を別途追加登録しておく必要がある(未登録だとstagingでのMicrosoftログインのみ失敗する)。
    "staging": {
      "name": "rectime-api-staging",
      "vars": {
        "ALLOWED_ORIGINS": "https://recwatch-tokyo.pages.dev,https://*.recwatch-tokyo.pages.dev",
        // Preview環境はレビュー時にSwagger UIで仕様を確認するため公開する。
        "DOCS_ENABLED": "true",
        // Entraのマルチテナント共通エンドポイント値。環境によらず同一。
        // Entraアプリの「アプリケーション(クライアント)ID」。非公開の資格情報ではないためvarsで直接設定する。
        "MICROSOFT_CLIENT_ID": "be597fc9-7946-43a2-9ba8-6a96c96fd3b7",
        "MICROSOFT_TENANT": "organizations",
        "ALLOWED_MICROSOFT_TENANTS": "8d41d6d7-36ce-4e0c-8c6d-cf2c54c39039",
        "MICROSOFT_MOBILE_REDIRECT_URI": "com.rectime.mobile://auth/callback",
        "FRONTEND_URL": "https://staging.recwatch-tokyo.pages.dev",
        "SESSION_EXPIRES_SEC": "86400",
        "JWT_EXPIRES_SEC": "3600",
        "MOBILE_REFRESH_EXPIRES_SEC": "7776000",
        "STUDENT_EMAIL_DOMAIN": "ths.hal.ac.jp",
        "CONTACT_FORM_URL": "https://forms.cloud.microsoft/r/LAsntFuQcF",
        // 通知配信を許可する開催日(YYYY-MM-DD)。未設定だと更新系エンドポイントが
        // 500になる(#204レビュー指摘)。本番相当の検証環境だが、実イベント日付に
        // 追随させる必要はないため固定のダミー値を使う。
        "EVENT_DATE": "2026-01-01",
        "IMAGES_BUCKET_URL": "https://539494518db0c8b96ec2f6fdd30fb990.r2.cloudflarestorage.com/rectime-images-staging",
      },
      "secrets": {
        "required": [
          "MICROSOFT_CLIENT_PRIVATE_KEY",
          "MICROSOFT_CERT_THUMBPRINT",
          "JWT_SECRET",
          "FIREBASE_PROJECT_ID",
          "FIREBASE_CLIENT_EMAIL",
          "FIREBASE_PRIVATE_KEY",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
        ],
      },
      // 本番相当のcronを検証したくなった時点で有効化を検討する。まずは無効で始める。
      "triggers": {
        "crons": [],
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "c88c52ca05d84e8c974ca6916bdc1e33",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rectime-api-staging",
          "database_id": "66800d75-64bc-4a80-ad09-5683e19ebff8",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "IMAGES",
          "bucket_name": "rectime-images-staging",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "MASTER_IMPORT_COMMIT_LOCK",
            "class_name": "MasterImportCommitLock",
          },
        ],
      },
      // staging専用のキュー。development/previewと共有しないため、producer/consumerとも
      // このWorkerだけで完結する(1キュー1consumerの制約に抵触しない)。
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATION_DELIVERY_QUEUE",
            "queue": "rectime-notification-delivery-staging",
          },
        ],
        "consumers": [
          {
            "queue": "rectime-notification-delivery-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 5,
            // Must stay below the 6-minute delivery lease in NotificationDelivery.ts.
            "retry_delay": 300,
            "max_concurrency": 10,
          },
        ],
      },
    },
  },
}
