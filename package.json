{
  "name": "recreation-management-api",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "wrangler dev --env development --ip 0.0.0.0",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:remote": "wrangler d1 migrations apply rectime-api --remote",
    "db:migrate:local": "wrangler d1 migrations apply rectime-api-dev --local --env development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run type-check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.10",
    "crypto": "^1.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "read-excel-file": "^9.3.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20250909.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.4.0"
  },
  "packageManager": "npm@10.9.2"
}
